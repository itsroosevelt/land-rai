rules_version = '2';

// Aislamiento multi-tenant.
//
// Todo dato de cliente vive bajo users/{uid}/... y SOLO su dueño puede leerlo o
// escribirlo desde el SDK web. Cualquier otra ruta queda denegada para clientes;
// las rutas API, webhooks y Cloud Functions usan el Admin SDK (que ignora estas
// reglas) y verifican la identidad por su cuenta (ver src/lib/apiAuth.ts).
//
// NO agregar reglas globales (`/{document=**}`) ni `allow ...: if true`: anulan
// el aislamiento entre clientes. Las consultas collectionGroup desde el navegador
// quedan denegadas a propósito: hacerlas por el servidor.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // entities/*, entity_slugs/*, subscriptions/*, paymentRequests/*, referrals/* ...
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Todo lo demás (system_mappings, webhook_diagnostics, ...): solo servidor.
  }
}
